# =================================================================
# CONFIGURAÇÕES DO LEAD HUNTER & PROPOSTA VISUAL
# =================================================================

# 1. Supabase (Crie um projeto grátis em supabase.com e pegue no Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# 2. Google Maps / Places API (Google Cloud Console > Credentials > Places API (New))
# Se deixar em branco, o app funciona no modo inteligente com dados de demonstração de alta precisão
GOOGLE_MAPS_API_KEY=

# 3. Google Gemini AI (Google AI Studio > Get API Key)
# Se deixar em branco, o app usa o motor contextual nativo otimizado
GEMINI_API_KEY=

# 4. Dados do Desenvolvedor (Usados na assinatura das propostas e mensagens de WhatsApp)
NEXT_PUBLIC_DEVELOPER_NAME="José | Desenvolvedor Web & Automação"
NEXT_PUBLIC_DEVELOPER_WHATSAPP="5511999999999"

# 5. URL da Aplicação (Para gerar os links públicos de propostas enviados no WhatsApp)
NEXT_PUBLIC_APP_URL=http://localhost:3000
